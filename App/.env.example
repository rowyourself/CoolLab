# Copia este archivo como ".env" y ajusta los valores.

# Nombre que aparece en los informes PDF y en la app
COMPANY_NAME=Mi Empresa de Refrigeración

# Puerto local donde corre la app (Cloudflare Tunnel apunta aquí)
PORT=3000

# Tu dirección pública (se usa en el QR del informe)
PUBLIC_URL=https://visitas.tudominio.cl

# Administrador inicial (solo se usa la primera vez que arranca, con la base vacía)
ADMIN_EMAIL=admin@tudominio.cl
ADMIN_PASSWORD=cambia-esta-clave-larga

# 1 = cookie solo por HTTPS (déjalo en 1 cuando uses el dominio con Cloudflare)
COOKIE_SECURE=1

# Zona horaria de los informes
TZ=America/Santiago

# Radio (metros) para validar que el técnico estuvo en la empresa al iniciar y terminar
GEOFENCE_M=300

# Clima: por defecto Open-Meteo (gratis, sin clave). Si prefieres OpenWeatherMap, pon tu API key:
# OPENWEATHER_KEY=

# Carpetas de datos (por defecto ./data y ./uploads). Respáldalas.
# DATA_DIR=
# UPLOAD_DIR=
