# Copiar como /opt/coollab/.env en el servidor Vultr y ajustar.
COMPANY_NAME=Mi Empresa de Refrigeración
# 3100 para no chocar con el juego (que usa 3000)
PORT=3100
# Solo escucha dentro del servidor (Cloudflare entra por el túnel)
HOST=127.0.0.1
# Tu subdominio final en Cloudflare (se usa en el QR de los informes)
PUBLIC_URL=https://coollab.auroragenesys.com
ADMIN_EMAIL=admin@auroragenesys.com
ADMIN_PASSWORD=pon-una-clave-larga-y-unica
COOKIE_SECURE=1
TZ=America/Santiago
GEOFENCE_M=300
